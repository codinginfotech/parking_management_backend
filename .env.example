# Server
NODE_ENV=development
PORT=4000

# MySQL connection string (Prisma). URL-encode special characters in the
# password (e.g. @ -> %40). For hosted MySQL (cPanel etc.), whitelist your
# machine's IP under "Remote MySQL" first.
DATABASE_URL=mysql://user:password@host:3306/database

# JWT — generate long random strings, e.g. `openssl rand -hex 64`
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth — Web client ID from Google Cloud Console.
# You may pass multiple comma-separated client IDs (web + iOS) as accepted audiences.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# CORS — comma-separated origins allowed to call the API ("*" allows all)
CORS_ORIGIN=*

# IST offset used for daily report boundaries (minutes east of UTC)
TIMEZONE_OFFSET_MINUTES=330
